{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "DOM", "DOM.Iterable"],
    "types": ["vitepress/client"],
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true
  },
  "include": ["**/*.ts", "**/*.vue"]
}
